{
  "name": "nll-mock-server",
  "version": "0.1.0",
  "description": "Mock of the Swedish National Medication List (NLL) FHIR R4 API for local development",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "migrate": "tsx src/migrate.ts",
    "seed": "tsx src/seed.ts",
    "seed-bulk": "tsx src/seed-bulk.ts",
    "typecheck": "tsc --noEmit",
    "smoke": "tsx test/smoke.ts"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "pg": "^8.12.0",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.5.0",
    "@types/pg": "^8.11.6",
    "@types/uuid": "^9.0.8",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4",
    "pg-mem": "^3.0.3"
  }
}